#!/usr/bin/env bash
set -euo pipefail

# os-build: nixos-rebuild wrapper with automatic vcsh backup

BACKUP_DIR="${BACKUP_DIR:-$HOME/.nixos}"
NIXOS_DIR="${NIXOS_DIR:-/etc/nixos}"
VCSH_REPO="${VCSH_REPO:-nixos}"
NIXOS_REBUILD="${NIXOS_REBUILD:-sudo nixos-rebuild}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/nixos-backup/config.yaml"

show_help() {
    cat <<'EOF'
os-build - nixos-rebuild wrapper with automatic vcsh backup

USAGE
    os-build [OPTIONS] [ACTION] [NIXOS-REBUILD-ARGS...]

OPTIONS
    --no-backup       Skip backup after rebuild
    --help            Show this help
    --rebuild-help    Show nixos-rebuild --help

ACTIONS
    switch            Build and activate (default)
    boot              Build and set as boot default
    test              Build and activate, don't add to boot
    build             Build only
    dry-build         Show what would be built
    (any nixos-rebuild action)

EXAMPLES
    os-build                     # switch + backup
    os-build --no-backup         # switch without backup
    os-build test                # test + backup
    os-build switch --flake .    # flake-based switch + backup

ENVIRONMENT
    BACKUP_DIR      Backup destination (default: ~/.nixos)
    NIXOS_DIR       NixOS config source (default: /etc/nixos)
    VCSH_REPO       vcsh repo name (default: nixos)

CONFIG
    ~/.config/nixos-backup/config.yaml

SEE ALSO
    os-build(1), nixos-rebuild(8)
EOF
    exit 0
}

# Handle help flags
case "${1:-}" in
    --help|-h) show_help ;;
    --rebuild-help) exec nixos-rebuild --help ;;
esac

do_backup=true
[[ "${1:-}" == "--no-backup" ]] && { do_backup=false; shift; }

# Run nixos-rebuild (default: switch)
$NIXOS_REBUILD "${@:-switch}" "--sudo"

# Backup on success
if $do_backup; then
    mkdir -p "$BACKUP_DIR"

    # Read files from config or use defaults
    if command -v yq &>/dev/null && [[ -f "$CONFIG" ]]; then
        mapfile -t files < <(yq -r '.files[]' "$CONFIG")
    else
        files=(configuration.nix flake.nix flake.lock hardware-configuration.nix home.nix packages.nix)
    fi

    # Copy files
    for f in "${files[@]}"; do
        [[ -f "$NIXOS_DIR/$f" ]] && cp "$NIXOS_DIR/$f" "$BACKUP_DIR/$f"
    done

    # Commit if vcsh available
    if command -v vcsh &>/dev/null; then
        for f in "${files[@]}"; do
            [[ -f "$BACKUP_DIR/$f" ]] && vcsh "$VCSH_REPO" add "$BACKUP_DIR/$f" 2>/dev/null || true
        done

        if ! vcsh "$VCSH_REPO" diff --cached --quiet 2>/dev/null; then
            vcsh "$VCSH_REPO" commit -m "$(printf 'NixOS backup: %s\nVersion: %s | Gen: %s' \
                "$(date '+%Y-%m-%d %H:%M')" \
                "$(nixos-version 2>/dev/null || echo unknown)" \
                "$(readlink /nix/var/nix/profiles/system 2>/dev/null | grep -o '[0-9]*' || echo '?')")"
            echo "Backup committed"
        else
            echo "No config changes to commit"
        fi
    fi
fi
